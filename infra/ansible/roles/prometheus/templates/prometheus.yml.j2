# Managed by Ansible
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]

  - job_name: node_exporter
    static_configs:
      - targets: ["localhost:{{ node_exporter_port }}"]

  # Requires the "Prometheus metrics" plugin in Jenkins
  - job_name: jenkins
    metrics_path: /prometheus
    static_configs:
      - targets: ["localhost:{{ jenkins_port }}"]
{% if k8s_node_targets | length > 0 %}

  - job_name: k8s_nodes
    static_configs:
      - targets:
{% for t in k8s_node_targets %}
          - "{{ t }}"
{% endfor %}
{% endif %}
